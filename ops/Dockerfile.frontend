# Frontend image (architecture.md 11.3, D12): Node exists only in the build
# stage; the shipped image is nginx plus the built static files.
# Build from the repo root:
#   docker build -f ops/Dockerfile.frontend -t ytdigest-web:latest .

# ---- build ----
FROM node:24-alpine AS build
WORKDIR /src
# The manifests come before any source, so editing a file under web/src never
# invalidates the npm ci layer. `npm ci`, not `npm install`: it fails when
# package.json and the lockfile disagree. NODE_ENV is deliberately not set:
# tsc, vite and openapi-typescript are devDependencies the build needs.
COPY web/package.json web/package-lock.json ./
RUN npm ci
# The rest of web/ (src, scripts/, openapi.json, index.html, tsconfig, vite
# config). `npm run build` runs the prebuild hook (`gen:api`) first, from the
# committed openapi.json: no Python, no backend, no network.
COPY web/ .
ARG VITE_API_BASE=/api
RUN npm run build

# ---- runtime ----
# nginx's maintained stable line, in the unprivileged variant (#140): it listens
# on 8080 and keeps the pid file and temp paths under /tmp, so it runs as a
# non-root user with a read-only root filesystem. Pinned by tag, not digest
# (digest pinning is #241).
FROM nginx/nginx-unprivileged:1.30-alpine
# Root only for the build-time cleanup below; the container starts as 101.
USER root
# The base image ships its own index.html and 50x.html; the served tree must
# be exactly what the build produced.
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /src/dist /usr/share/nginx/html
COPY ops/nginx.conf /etc/nginx/conf.d/default.conf
# Numeric, so `docker run --user` checks and runAsNonRoot policies can verify it.
USER 101
# No HEALTHCHECK: compose owns it (#58). The base image's ENTRYPOINT and CMD
# are exec form, so nginx is PID 1 and receives the stop signal directly.
